    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Guava cache instrumented as cache name Guava on balancereader, transactionhistory, and ledgerwriter.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "showPoints": "never",
            "spanNulls": false
          },
          "max": 1,
          "min": 0,
